   "source": [
    "#Question 7 \n",
    "\n",
    "\n",
    "start_hour = 12 \n",
    "start_min = 17\n",
    "\n",
    "time_in_min = start_hour * 60 + start_min\n",
    "\n",
    "time_to_add = 59\n",
    "\n",
    "total_time_in_mins = time_in_min + time_to_add\n",
    "time_in_hours = total_time_in_mins // 60\n",
    "time_in_mins = total_time_in_mins % 60"
   ]
