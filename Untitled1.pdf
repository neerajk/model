   "source": [
    "#Question 6\n",
    "\n",
    "fahrenheit = 98.6 \n",
    "celsius = (fahrenheit - 32) * 5 / 9\n",
    "print(f\"Temperature: {fahrenheit}°F = {celsius:.2f}°C\")\n"
   ]
  },
