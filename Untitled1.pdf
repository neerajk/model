   ],
   "source": [
    "#Question 4\n",
    "\n",
    "basic_salary = 5000\n",
    "\n",
    "dearness_allowance = 0.4 * basic_salary\n",
    "\n",
    "hra = 0.2 * basic_salary\n",
    "\n",
    "gross_salary = basic_salary + dearness_allowance + hra\n",
    "\n",
    "print('Gross Salary of Ram: ',gross_salary)"
   ]
  },
